# Copy this file to .env, then fill in the tunnel token.
#
# DO NOT COMMIT .env. It is ignored by git and by the Docker build context.
# The app still works without a tunnel if you only want local Docker.

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker
# connector. Copy the long token after "docker run ... --token".
CLOUDFLARE_TUNNEL_TOKEN=

# Admin / moderation.
# Set a long random password; /admin stays disabled while this is empty.
# The username defaults to "admin" if omitted.
OIEP_ADMIN_USERNAME=admin
OIEP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional overrides.
# Port bound on the server's loopback interface only (default 8080).
# OIEP_PORT=8080
# Show the six fictional demo reports on an empty database (default false).
# OIEP_DEMO_DATA=false
# TZ=Asia/Hong_Kong
