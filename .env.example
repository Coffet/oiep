# Copy this file to .env, then fill in the tunnel token.
#
# DO NOT COMMIT .env. It is ignored by git and by the Docker build context.
# The app still works without a tunnel if you only want local Docker.

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker
# connector. Copy the long token after "docker run ... --token".
CLOUDFLARE_TUNNEL_TOKEN=

# Admin / moderation.
# Generate a unique long random password (at least 16 characters, e.g. from a password
# manager). /admin stays disabled while this is empty. Never reuse the tunnel token or
# your SSH password, and never commit the real value.
# Note: a password copied verbatim from this repository's docs is detected and rejected;
# the admin area stays disabled in that case.
OIEP_ADMIN_USERNAME=admin
OIEP_ADMIN_PASSWORD=

# Optional overrides.
# Port bound on the server's loopback interface only (default 8080).
# OIEP_PORT=8080
# Show the six fictional demo reports on an empty database (default false).
# OIEP_DEMO_DATA=false
# TZ=Asia/Hong_Kong

# Security defaults for the shipped Docker + Cloudflare Tunnel deployment.
# compose.yaml already sets these; override only if you know why.
# - Behind Cloudflare Tunnel the real visitor IP arrives in CF-Connecting-IP; the app
#   uses it for per-client rate limits and never trusts client-supplied X-Forwarded-For.
# OIEP_TRUST_CLOUDFLARE_CONNECTING_IP=true
# - The public site is HTTPS, so mark the session cookie Secure.
# OIEP_SESSION_COOKIE_SECURE=true
# - Hard ceiling on concurrent server-side sessions (session-exhaustion DoS backstop).
# OIEP_SESSIONS_MAX_ACTIVE=10000

# ---------------------------------------------------------------------------
# Optional AI companion (oiep-backendAI) — OFF by default.
#
# A separate, self-hosted, local-first service (https://github.com/Coffet/oiep-backendAI)
# that adds three optional surfaces:
#   - a form-filling chat widget on the public form page,
#   - a read-only experiences API for the companion's corpus sync,
#   - an operator-only helper page at /admin/assistant (server-side proxy).
#
# Leave this block commented out (or set OIEP_COMPANION_ENABLED=false) and OIEP
# behaves exactly as before: no component routes, page fragments or CSP changes.
# Full reference, trust model, add/remove procedure: docs/COMPANION.md
#
# The two tokens are real secrets: generate them (see docs/COMPANION.md) and
# never commit them. Values copied verbatim from this repository's documentation
# or examples are rejected, and the sub-feature stays disabled.
# ---------------------------------------------------------------------------

# Master switch. false (default) = the whole component is inert.
# OIEP_COMPANION_ENABLED=false

# Companion origin used by the OIEP server (plain origin, no path).
# Bare metal: http://127.0.0.1:8090
# Docker Compose overlay: http://ai:8090 (the internal service name).
# OIEP_COMPANION_BASE_URL=

# Public form-page widget (iframe). The visitor's browser loads this URL
# directly, so it must be publicly reachable — never the internal Docker name.
# Defaults to <base-url>/ui/ when empty.
# OIEP_COMPANION_USER_HELPER_ENABLED=true
# OIEP_COMPANION_WIDGET_URL=

# Operator-only admin helper at /admin/assistant (server-side proxy, token never
# reaches the browser). Set a 32+ character token; it must equal the companion's
# OIEP_AI_ADMIN_TOKEN. REQUIRED when using compose.companion.yaml (the overlay
# refuses to start without it; the companion runs in prod mode and fails closed).
# OIEP_COMPANION_ADMIN_HELPER_ENABLED=false
# OIEP_COMPANION_ADMIN_TOKEN=
# Non-loopback HTTP exposes the token to interception. Prefer HTTPS; set this
# explicitly to true only if you accept that risk (including Docker's http://ai).
# OIEP_COMPANION_ADMIN_ALLOW_INSECURE_HTTP=false

# Read-only experiences API (GET /api/v1/experiences) consumed by the companion's
# corpus sync. Set a 16+ character token; it must equal the companion's
# OIEP_AI_OIEP_SYNC_TOKEN.
# OIEP_COMPANION_READ_API_ENABLED=false
# OIEP_COMPANION_READ_TOKEN=
# OIEP_COMPANION_READ_PAGE_SIZE=200

# OIEP does not collect interview difficulty, so the read API emits a documented
# value for every experience. constant (default) uses READ_DIFFICULTY for all
# items; vibe-proxy derives a coarse value from the interviewer-vibe field.
# OIEP_COMPANION_READ_DIFFICULTY=MODERATE
# OIEP_COMPANION_READ_DIFFICULTY_MODE=constant

# Server-side admin proxy timeouts, in milliseconds.
# OIEP_COMPANION_CONNECT_TIMEOUT_MS=3000
# OIEP_COMPANION_REQUEST_TIMEOUT_MS=15000

# --- Only for the optional Docker Compose overlay (compose.companion.yaml) ----
# The overlay maps the two OIEP_COMPANION_* tokens above onto the companion's own
# environment variable names (OIEP_AI_ADMIN_TOKEN / OIEP_AI_OIEP_SYNC_TOKEN), so
# you set each secret once. The values below are passed to the companion
# container only; they are ignored by a bare-metal OIEP start.
#
# Companion environment: prod makes it fail closed on weak secrets and requires
# https:// for the OIEP base URL and CORS origins.
# OIEP_AI_ENV=prod
# Salt used to hash visitor IPs (16+ random characters). REQUIRED when using
# compose.companion.yaml (prod mode refuses to start without it).
# OIEP_AI_IP_HASH_SALT=
# Public URL of the companion service (informational).
# OIEP_AI_PUBLIC_BASE_URL=
# Public HTTPS URL of this OIEP instance, used by the read-only corpus sync.
# Leave empty to run without sync.
# OIEP_AI_OIEP_BASE_URL=
# Background sync (the operator can always trigger a sync from /admin/assistant).
# OIEP_AI_SYNC_ENABLED=false
# Proxies allowed to set X-Forwarded-For / CF-Connecting-IP. Empty (the safe
# default) trusts no proxy headers: per-visitor rate limits and hashed audit IPs
# then see the Docker peer address. For a Cloudflare Tunnel deployment set this
# to the exact cloudflared container address/subnet — never to broad RFC1918
# ranges or 127.0.0.1, because any process/container that can reach the port
# could then forge the rate-limit and audit identity.
# OIEP_AI_TRUSTED_PROXIES=
# Optional CIDR allowlist for the companion admin API (leave empty = token only).
# OIEP_AI_ADMIN_IP_ALLOWLIST=
# Browser origin(s) allowed to embed the /ui/ widget and use the prefill hand-off
# (comma-separated, e.g. http://127.0.0.1:8080 locally or https://oiep.example).
# Empty disables the hand-off (fail closed) and logs a production warning.
# OIEP_AI_WIDGET_PARENT_ORIGINS=

# Read API per-client throttle (the public endpoint counts failed bearer attempts
# too and returns 429 + Retry-After once exhausted; the bucket map is bounded).
# OIEP_COMPANION_READ_RATE_LIMIT_MAX_REQUESTS=120
# OIEP_COMPANION_READ_RATE_LIMIT_WINDOW_SECONDS=60
# OIEP_COMPANION_READ_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000
# Optional browser origins for the companion API when the widget is hosted
# off-origin (the iframe embed needs none; https:// only in prod).
# OIEP_AI_CORS_ORIGINS=
# Optional: a prebuilt companion image instead of building ../oiep-backendAI.
# OIEP_AI_IMAGE=
# Build context of the companion checkout (relative to this directory).
# OIEP_AI_BUILD_CONTEXT=../oiep-backendAI
# Host loopback port the companion is published on (default 8090).
# OIEP_AI_PUBLISH_PORT=8090
