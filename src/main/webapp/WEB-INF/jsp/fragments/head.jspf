<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${pageTitle}"/></title>
<meta name="description" content="<c:out value="${pageDescription}"/>">
<meta name="theme-color" content="#F5EBD5">
<meta name="color-scheme" content="light">
<meta property="og:site_name" content="OIEP">
<meta property="og:title" content="<c:out value="${pageTitle}"/>">
<meta property="og:description" content="<c:out value="${pageDescription}"/>">
<meta property="og:type" content="website">
<link rel="icon" href="${ctx}/favicon.svg" type="image/svg+xml">
<link rel="preload" href="${ctx}/fonts/Y1CandyCore.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="${ctx}/fonts/InstrumentSans.woff2" as="font" type="font/woff2" crossorigin>
<style>html{background:#F5EBD5;color:#111820}body{margin:0}</style>
<script>document.documentElement.classList.replace('no-js','js');</script>
<link rel="stylesheet" href="${ctx}/css/site.css">
<c:if test="${adminCss}"><link rel="stylesheet" href="${ctx}/css/admin.css"></c:if>
<script src="${ctx}/js/site.js" defer></script>
