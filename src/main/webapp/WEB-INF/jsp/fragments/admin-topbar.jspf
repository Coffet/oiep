<a class="skip-link" href="#main"><spring:message code="skip.link"/></a>
<header class="topbar topbar--admin" data-topbar>
  <a class="brand" href="${ctx}/" aria-label="<spring:message code='site.logoAlt'/>">
    <span class="brand__word">oiep</span>
    <span class="brand__descriptor"><spring:message code="admin.brand"/></span>
  </a>
  <nav class="topbar__nav" aria-label="<spring:message code='nav.primary'/>">
    <div class="lang-switch" role="group" aria-label="<spring:message code='nav.language'/>">
      <c:url var="langEnUrl" value="/language/en">
        <c:param name="returnTo" value="${empty currentUrl ? '/admin' : currentUrl}"/>
      </c:url>
      <c:url var="langZhUrl" value="/language/zh-HK">
        <c:param name="returnTo" value="${empty currentUrl ? '/admin' : currentUrl}"/>
      </c:url>
      <a class="lang-switch__link ${isZh ? '' : 'is-current'}" href="${langEnUrl}" lang="en" hreflang="en" aria-label="<spring:message code='lang.en.aria'/>"<c:if test="${not isZh}"> aria-current="true"</c:if>>EN</a>
      <span class="lang-switch__slash" aria-hidden="true">/</span>
      <a class="lang-switch__link ${isZh ? 'is-current' : ''}" href="${langZhUrl}" lang="zh-HK" hreflang="zh-HK" aria-label="<spring:message code='lang.zh.aria'/>"<c:if test="${isZh}"> aria-current="true"</c:if>><spring:message code="lang.zh"/></a>
    </div>
    <c:choose>
      <c:when test="${adminAuthenticated}">
        <a class="topbar__browse" href="${ctx}/admin"<c:if test="${activeNav eq 'admin'}"> aria-current="page"</c:if>><spring:message code="admin.nav.dashboard"/></a>
        <a class="topbar__browse" href="${ctx}/"><spring:message code="admin.nav.site"/></a>
        <form class="admin-logout" action="${ctx}/admin/logout" method="post">
          <input type="hidden" name="_csrf" value="<c:out value='${adminCsrfToken}'/>">
          <button class="topbar__browse admin-logout__button" type="submit"><spring:message code="admin.logout"/></button>
        </form>
      </c:when>
      <c:otherwise>
        <a class="topbar__browse" href="${ctx}/"><spring:message code="admin.nav.site"/></a>
      </c:otherwise>
    </c:choose>
  </nav>
</header>
